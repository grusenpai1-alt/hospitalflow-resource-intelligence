rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed model:
    // users/{uid}: administrator-provisioned {facilityId, facilityName, role}.
    // facilities/{facilityId}/workflows/{workflowId}: {data, updatedBy, updatedAt}.
    // Workflow IDs are allow-listed below; records are synthetic operational data only.

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasFacilityProfile(facilityId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.facilityId == facilityId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['admin', 'coordinator', 'operations', 'nurse', 'housekeeping', 'lab',
              'resource_manager', 'pharmacy', 'clinical', 'blood_bank', 'ambulance',
              'infection_control', 'viewer'];
    }

    function canWriteFacility(facilityId) {
      return hasFacilityProfile(facilityId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'viewer';
    }

    function isSupportedWorkflow(workflowId) {
      return workflowId in [
        'bed-turnaround-cases-v1',
        'workflow-settings-v1',
        'hospital-flow-lab-reservations-v1',
        'hospital-flow-equipment-bookings-v1',
        'hospital-flow-camp-allocations-v1',
        'hospital-flow-pharmacy-v1',
        'hospital-flow-trauma-bays-v1',
        'hospital-flow-clinicians-v1',
        'hospital-flow-staff-coverage-v1',
        'hospital-flow-alerts-v1',
        'hospital-flow-blood-bank-v1',
        'hospital-flow-ambulance-arrivals-v1',
        'hospital-flow-isolation-rooms-v1',
        'bed-occupancy-board-v1'
      ];
    }

    function isRecent(time) {
      return time is timestamp
        && time > request.time - duration.value(5, 'm')
        && time <= request.time;
    }

    function isValidSettings(data) {
      return data is map
        && data.keys().hasOnly([
          'billingOptional',
          'pendingPhotoExpiryDays',
          'approvedPhotoRetentionHours',
          'autoPurgeIntervalSeconds'
        ])
        && data.keys().hasAll([
          'billingOptional',
          'pendingPhotoExpiryDays',
          'approvedPhotoRetentionHours',
          'autoPurgeIntervalSeconds'
        ])
        && data.billingOptional is bool
        && data.pendingPhotoExpiryDays is number
        && data.pendingPhotoExpiryDays >= 1
        && data.pendingPhotoExpiryDays <= 30
        && data.approvedPhotoRetentionHours is number
        && data.approvedPhotoRetentionHours == 48
        && data.autoPurgeIntervalSeconds is number
        && data.autoPurgeIntervalSeconds >= 15
        && data.autoPurgeIntervalSeconds <= 3600;
    }

    function isValidOccupancyBoard(data) {
      return data is map
        && data.keys().hasOnly(['beds', 'crew', 'events'])
        && data.keys().hasAll(['beds', 'crew', 'events'])
        && data.beds is list
        && data.beds.size() <= 200
        && data.crew is list
        && data.crew.size() <= 100
        && data.events is list
        && data.events.size() <= 200;
    }

    function isValidEquipmentData(data) {
      return data is list && data.size() <= 500
        || data is map
          && data.keys().hasOnly(['bookings', 'outages'])
          && data.keys().hasAll(['bookings', 'outages'])
          && data.bookings is list
          && data.bookings.size() <= 500
          && data.outages is list
          && data.outages.size() <= 500;
    }

    function isValidPharmacyData(data) {
      return data is list && data.size() <= 500
        || data is map
          && data.keys().hasOnly(['items', 'events'])
          && data.keys().hasAll(['items', 'events'])
          && data.items is list
          && data.items.size() <= 500
          && data.events is list
          && data.events.size() <= 200;
    }

    function isValidBloodBankData(data) {
      return data is list && data.size() <= 500
        || data is map
          && data.keys().hasOnly(['products', 'events'])
          && data.keys().hasAll(['products', 'events'])
          && data.products is list
          && data.products.size() <= 500
          && data.events is list
          && data.events.size() <= 200;
    }

    function isValidWorkflowData(workflowId, data) {
      return workflowId == 'workflow-settings-v1'
        ? isValidSettings(data)
        : workflowId == 'bed-occupancy-board-v1'
          ? isValidOccupancyBoard(data)
          : workflowId == 'hospital-flow-equipment-bookings-v1'
            ? isValidEquipmentData(data)
            : workflowId == 'hospital-flow-pharmacy-v1'
              ? isValidPharmacyData(data)
              : workflowId == 'hospital-flow-blood-bank-v1'
                ? isValidBloodBankData(data)
          : data is list && data.size() <= 500;
    }

    function isValidWorkflowDocument(workflowId) {
      return isSupportedWorkflow(workflowId)
        && request.resource.data.keys().hasOnly(['data', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasAll(['data', 'updatedBy', 'updatedAt'])
        && request.resource.data.updatedBy == request.auth.uid
        && isRecent(request.resource.data.updatedAt)
        && isValidWorkflowData(workflowId, request.resource.data.data);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /facilities/{facilityId}/workflows/{workflowId} {
      allow read: if hasFacilityProfile(facilityId) && isSupportedWorkflow(workflowId);
      allow create, update: if canWriteFacility(facilityId)
        && isValidWorkflowDocument(workflowId);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
